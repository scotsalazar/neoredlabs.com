datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SlotAvailability {
  id           Int            @id @default(autoincrement())
  slotDate     DateTime
  slot         String
  capacity     Int            @default(1)
  createdAt    DateTime       @default(now())
  appointments Appointment[]

  @@unique([slotDate, slot])
}

model Appointment {
  id                 Int              @id @default(autoincrement())
  fullName           String
  email              String
  notes              String?
  slotAvailabilityId Int
  createdAt          DateTime         @default(now())

  slotAvailability SlotAvailability @relation(fields: [slotAvailabilityId], references: [id], onDelete: Cascade)
}

model BusinessPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  category    String
  summary     String
  content     String
  imageUrl    String
  publishedAt DateTime?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

model CareerApplication {
  id                    Int      @id @default(autoincrement())
  name                  String
  email                 String?
  role                  String
  answerAiTools         String
  answerApi             String
  answerModernWorkflows String
  score                 Int
  passed                Boolean
  passingScore          Int      @default(70)
  recommendation        String
  aiGeneratedRisk       String
  categoryScores        Json
  strengths             Json
  concerns              Json
  summary               String
  createdAt             DateTime @default(now())

  @@index([role, passed, score])
  @@index([createdAt])
}
